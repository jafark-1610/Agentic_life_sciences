{
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "chips",
    "courses",
    "selection"
  ],
  "properties": {
    "schema": {
      "const": "tmdd_pulse/1"
    },
    "case_id": {
      "const": "ALS_TMDD_PULSE_002"
    },
    "chips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "calibration",
          "models",
          "target_capacity_interval",
          "target_capacity_point_identified",
          "local_rank",
          "fit_rmse"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "calibration": {
            "type": "object",
            "required": [
              "plasma",
              "tissue_total"
            ],
            "properties": {
              "plasma": {
                "type": "object",
                "required": [
                  "gain",
                  "kd",
                  "offset"
                ],
                "properties": {
                  "gain": {
                    "type": "number"
                  },
                  "kd": {
                    "type": "number"
                  },
                  "offset": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "tissue_total": {
                "type": "object",
                "required": [
                  "gain",
                  "kd",
                  "offset"
                ],
                "properties": {
                  "gain": {
                    "type": "number"
                  },
                  "kd": {
                    "type": "number"
                  },
                  "offset": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "models": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 10,
              "maxItems": 10
            },
            "minItems": 1,
            "maxItems": 8
          },
          "target_capacity_interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "target_capacity_point_identified": {
            "type": "boolean"
          },
          "local_rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "fit_rmse": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 6
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "minimum_efficacy",
          "maximum_peak_free",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "minimum_efficacy": {
            "type": "number"
          },
          "maximum_peak_free": {
            "type": "number"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chip",
                "model_index",
                "scenario",
                "efficacy",
                "peak_free"
              ],
              "properties": {
                "chip": {
                  "type": "string"
                },
                "model_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "scenario": {
                  "type": "string"
                },
                "efficacy": {
                  "type": "number"
                },
                "peak_free": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 48,
      "maxItems": 48
    },
    "selection": {
      "type": "object",
      "required": [
        "status",
        "course",
        "peak_witness"
      ],
      "properties": {
        "status": {
          "enum": [
            "selected",
            "no_qualifying_course"
          ]
        },
        "course": {
          "type": [
            "string",
            "null"
          ]
        },
        "peak_witness": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "chip",
                "model_index",
                "scenario",
                "time",
                "value"
              ],
              "properties": {
                "chip": {
                  "type": "string"
                },
                "model_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "scenario": {
                  "type": "string"
                },
                "time": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 36
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
