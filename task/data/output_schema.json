{
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "contexts",
    "global_policies",
    "selection"
  ],
  "properties": {
    "schema": {
      "const": "paired_immunity/1"
    },
    "case_id": {
      "const": "ALS_PAIRED_IMMUNITY_003"
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "policies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "eligibility_lower",
                "eligibility_upper",
                "net_gain_lower",
                "net_gain_upper",
                "harm_upper",
                "cost_upper",
                "point_identified"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "eligibility_lower": {
                  "type": "number"
                },
                "eligibility_upper": {
                  "type": "number"
                },
                "net_gain_lower": {
                  "type": "number"
                },
                "net_gain_upper": {
                  "type": "number"
                },
                "harm_upper": {
                  "type": "number"
                },
                "cost_upper": {
                  "type": "number"
                },
                "point_identified": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "minItems": 24,
            "maxItems": 24
          }
        },
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "global_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "worst_net_gain",
          "worst_harm",
          "worst_cost",
          "minimum_eligibility",
          "resource_adjusted_score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "worst_net_gain": {
            "type": "number"
          },
          "worst_harm": {
            "type": "number"
          },
          "worst_cost": {
            "type": "number"
          },
          "minimum_eligibility": {
            "type": "number"
          },
          "resource_adjusted_score": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "minItems": 24,
      "maxItems": 24
    },
    "selection": {
      "type": "object",
      "required": [
        "status",
        "policy"
      ],
      "properties": {
        "status": {
          "enum": [
            "selected",
            "no_qualifying_policy"
          ]
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
